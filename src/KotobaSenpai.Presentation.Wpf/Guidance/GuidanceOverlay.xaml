<Canvas x:Class="KotobaSenpai.Presentation.Wpf.Guidance.GuidanceOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:presentation="clr-namespace:KotobaSenpai.Presentation.Wpf.Resources"
        Background="Transparent" ClipToBounds="True" Focusable="True"
        KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
  <Canvas.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary>
          <SolidColorBrush x:Key="{x:Static presentation:ThemeResourceKeys.SolidBackgroundFillColorBaseBrush}"
                           Color="{x:Static SystemColors.WindowColor}" />
          <SolidColorBrush x:Key="{x:Static presentation:ThemeResourceKeys.CardStrokeColorDefaultBrush}"
                           Color="{x:Static SystemColors.WindowTextColor}" />
          <SolidColorBrush x:Key="{x:Static presentation:ThemeResourceKeys.TextFillColorPrimaryBrush}"
                           Color="{x:Static SystemColors.WindowTextColor}" />
          <SolidColorBrush x:Key="{x:Static presentation:ThemeResourceKeys.AccentFillColorDefaultBrush}"
                           Color="{x:Static SystemColors.HighlightColor}" />
        </ResourceDictionary>
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="BubbleStyle" TargetType="Border">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="MaxWidth" Value="380" />
      </Style>
      <Style x:Key="HighlightStyle" TargetType="Border">
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="6" />
      </Style>
      <Style x:Key="MessageStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineHeight" Value="24" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
    </ResourceDictionary>
  </Canvas.Resources>

  <Path x:Name="_mask" Fill="#9B000000" IsHitTestVisible="False" />
  <Border x:Name="_highlight" Style="{StaticResource HighlightStyle}" IsHitTestVisible="False"
          BorderBrush="{DynamicResource {x:Static presentation:ThemeResourceKeys.AccentFillColorDefaultBrush}}" />
  <Polygon x:Name="_arrow" IsHitTestVisible="False"
           Fill="{DynamicResource {x:Static presentation:ThemeResourceKeys.SolidBackgroundFillColorBaseBrush}}" />
  <Border x:Name="_bubble" Style="{StaticResource BubbleStyle}"
          Background="{DynamicResource {x:Static presentation:ThemeResourceKeys.SolidBackgroundFillColorBaseBrush}}"
          BorderBrush="{DynamicResource {x:Static presentation:ThemeResourceKeys.CardStrokeColorDefaultBrush}}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <ScrollViewer x:Name="_body" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <TextBlock x:Name="_text" Style="{StaticResource MessageStyle}" AutomationProperties.LiveSetting="Polite"
                   Foreground="{DynamicResource {x:Static presentation:ThemeResourceKeys.TextFillColorPrimaryBrush}}" />
      </ScrollViewer>
      <Button x:Name="AcknowledgeAction" Grid.Row="1" HorizontalAlignment="Right"
              Margin="0,16,0,0" Padding="12,6" MinHeight="36" Cursor="Hand"
              Click="OnAcknowledgeClick">
        <Viewbox StretchDirection="DownOnly">
          <TextBlock x:Name="_acknowledgeText" />
        </Viewbox>
      </Button>
    </Grid>
  </Border>
</Canvas>
