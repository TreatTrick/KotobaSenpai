<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime"
                    xmlns:controls="clr-namespace:KotobaSenpai.App.Controls"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  <system:Double x:Key="SettingsInputWidth">280</system:Double>

  <Style x:Key="PageTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FluentTitleFontSize}" />
    <Setter Property="LineHeight" Value="{StaticResource FluentTitleLineHeight}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <Style x:Key="Description" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FluentCaptionFontSize}" />
    <Setter Property="LineHeight" Value="{StaticResource FluentCaptionLineHeight}" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="{StaticResource FluentDescriptionGap}" />
  </Style>
  <Style x:Key="PageDescription" TargetType="TextBlock" BasedOn="{StaticResource Description}">
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FluentBodyFontSize}" />
    <Setter Property="LineHeight" Value="{StaticResource FluentBodyLineHeight}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="{StaticResource FluentSectionHeadingSpacing}" />
  </Style>
  <Style x:Key="SettingsPageScrollViewer" TargetType="ScrollViewer">
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="Padding" Value="{StaticResource FluentPagePadding}" />
  </Style>

  <Style TargetType="controls:SettingsCard" BasedOn="{StaticResource DefaultUiCardControlStyle}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Padding" Value="{StaticResource FluentCardPadding}" />
    <Setter Property="MinHeight" Value="80" />
    <Setter Property="Margin" Value="{StaticResource FluentCardGap}" />
    <Setter Property="CornerRadius" Value="{StaticResource FluentCardRadius}" />
    <Setter Property="FontSize" Value="{StaticResource FluentBodyFontSize}" />
    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    <Setter Property="AutomationProperties.HelpText" Value="{Binding Description, RelativeSource={RelativeSource Self}}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:SettingsCard">
          <Border Padding="{TemplateBinding Padding}" CornerRadius="{TemplateBinding CornerRadius}"
                  Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ContentPresenter x:Name="CardIcon" Content="{TemplateBinding Icon}" Margin="0,0,16,0"
                                Width="24" Height="24" VerticalAlignment="Center" TextElement.FontSize="24" />
              <StackPanel Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"
                           FontSize="{StaticResource FluentBodyFontSize}" LineHeight="{StaticResource FluentBodyLineHeight}"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="CardDescription" Text="{TemplateBinding Description}" Style="{StaticResource Description}" />
                <ContentPresenter Content="{TemplateBinding DescriptionContent}" />
              </StackPanel>
              <ContentPresenter Grid.Column="2" Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
              <Setter TargetName="CardIcon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Description" Value="">
              <Setter TargetName="CardDescription" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SettingInput" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
    <Setter Property="Width" Value="{StaticResource SettingsInputWidth}" />
    <Setter Property="MinHeight" Value="{StaticResource FluentControlHeight}" />
    <Setter Property="FontSize" Value="{StaticResource FluentBodyFontSize}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style x:Key="SettingTextInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="MinHeight" Value="{StaticResource FluentControlHeight}" />
    <Setter Property="FontSize" Value="{StaticResource FluentBodyFontSize}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style x:Key="MaskedApiKeyInput" TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
    <Setter Property="MinHeight" Value="{StaticResource FluentControlHeight}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsApiKeyVisible}" Value="True">
        <Setter Property="Visibility" Value="Collapsed" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="VisibleApiKeyInput" TargetType="TextBox" BasedOn="{StaticResource SettingTextInput}">
    <Setter Property="Visibility" Value="Collapsed" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsApiKeyVisible}" Value="True">
        <Setter Property="Visibility" Value="Visible" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="SettingsButton" TargetType="ui:Button" BasedOn="{StaticResource DefaultUiButtonStyle}">
    <Setter Property="MinHeight" Value="{StaticResource FluentControlHeight}" />
    <Setter Property="FontSize" Value="{StaticResource FluentBodyFontSize}" />
    <Setter Property="Padding" Value="12,6" />
  </Style>
  <Style x:Key="SettingsActionButton" TargetType="ui:Button" BasedOn="{StaticResource SettingsButton}">
    <Setter Property="MinWidth" Value="136" />
  </Style>
  <Style x:Key="SettingsIconButton" TargetType="ui:Button" BasedOn="{StaticResource SettingsButton}">
    <Setter Property="Width" Value="{StaticResource FluentControlHeight}" />
    <Setter Property="Height" Value="{StaticResource FluentControlHeight}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="8,0,0,0" />
  </Style>
  <Style x:Key="SettingsToggle" TargetType="ui:ToggleSwitch" BasedOn="{StaticResource DefaultUiToggleSwitchStyle}">
    <Setter Property="LabelPosition" Value="Left" />
    <Setter Property="MinHeight" Value="{StaticResource FluentControlHeight}" />
    <Setter Property="FontSize" Value="{StaticResource FluentBodyFontSize}" />
  </Style>
  <Style x:Key="ModelStatus" TargetType="TextBlock" BasedOn="{StaticResource Description}">
    <Setter Property="Margin" Value="0,8,0,0" />
    <Style.Triggers>
      <Trigger Property="Text" Value="">
        <Setter Property="Visibility" Value="Collapsed" />
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
