<UserControl x:Class="KotobaSenpai.App.Views.MainContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:KotobaSenpai.App.Localization"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:KotobaSenpai.App.Views">
  <UserControl.Resources>
    <Style x:Key="NavigationTab" TargetType="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="NavigationBackground" Background="{TemplateBinding Background}"
                    CornerRadius="4" MinHeight="40">
              <Grid>
                <Border x:Name="SelectionIndicator" Width="3" Height="16" CornerRadius="2"
                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                        HorizontalAlignment="Left" Visibility="Collapsed" />
                <ContentPresenter ContentSource="Header" Margin="16,10"
                                  VerticalAlignment="Center" RecognizesAccessKey="True" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="NavigationBackground" Property="Background"
                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="NavigationBackground" Property="Background"
                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <Grid>
    <TabControl x:Name="MainNavigation" SelectedIndex="0" TabStripPlacement="Left"
                Background="Transparent" BorderThickness="0" Padding="0"
                ItemContainerStyle="{StaticResource NavigationTab}">
      <TabControl.Template>
        <ControlTemplate TargetType="TabControl">
          <Grid KeyboardNavigation.TabNavigation="Local">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="224" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TabPanel IsItemsHost="True" Margin="12,96,12,16" KeyboardNavigation.TabIndex="1"
                      KeyboardNavigation.DirectionalNavigation="Cycle" />
            <Border Grid.Column="1" CornerRadius="8,0,0,0"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"
                                  KeyboardNavigation.TabIndex="2" />
                <Border Grid.Row="1" Padding="32,12,32,16"
                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="Info24" FontSize="16" Margin="0,2,10,0"
                                   VerticalAlignment="Top" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding Recognition.Status}" Style="{StaticResource Description}" Margin="0"
                               AutomationProperties.LiveSetting="Polite" />
                  </Grid>
                </Border>
              </Grid>
            </Border>
          </Grid>
        </ControlTemplate>
      </TabControl.Template>

      <TabItem AutomationProperties.Name="{loc:Loc Key=Tab_Recognize}">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <Image Source="{StaticResource ScanColorIcon}" Width="24" Height="24" Margin="0,0,12,0" />
            <TextBlock Text="{loc:Loc Key=Tab_Recognize}" VerticalAlignment="Center" />
          </StackPanel>
        </TabItem.Header>
        <views:RecognitionPage DataContext="{Binding Recognition}" />
      </TabItem>

      <TabItem AutomationProperties.Name="{loc:Loc Key=Tab_Settings}">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <Image Source="{StaticResource SettingsColorIcon}" Width="24" Height="24" Margin="0,0,12,0" />
            <TextBlock Text="{loc:Loc Key=Tab_Settings}" VerticalAlignment="Center" />
          </StackPanel>
        </TabItem.Header>
        <views:SettingsPage x:Name="SettingsView" DataContext="{Binding Settings}" />
      </TabItem>
    </TabControl>

    <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Width="184" Margin="20,20,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Image Source="/KotobaSenpai.App;component/Assets/Branding/app-icon.png" Width="40" Height="40"
             RenderOptions.BitmapScalingMode="HighQuality" />
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
        <TextBlock Text="KotobaSenpai" FontWeight="SemiBold" FontSize="{StaticResource FluentEmphasisFontSize}" />
        <TextBlock Text="{loc:Loc Key=App_Subtitle}" Style="{StaticResource Description}" />
      </StackPanel>
    </Grid>

  </Grid>
</UserControl>
