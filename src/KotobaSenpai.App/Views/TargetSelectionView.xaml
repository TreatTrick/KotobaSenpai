<UserControl x:Class="KotobaSenpai.App.Views.TargetSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:KotobaSenpai.App.Localization"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:KotobaSenpai.App.Views"
             xmlns:controls="clr-namespace:KotobaSenpai.App.Controls">
      <controls:SettingsCard x:Name="TargetWindowCard" Header="{loc:Loc Key=Label_TargetWindow}"
                             Description="{loc:Loc Key=Description_TargetWindow}" AutomationProperties.Name="{Binding TargetTitle}">
        <controls:SettingsCard.Style>
          <Style TargetType="controls:SettingsCard" BasedOn="{StaticResource {x:Type controls:SettingsCard}}">
            <Style.Triggers><DataTrigger Binding="{Binding IsOnboarding, RelativeSource={RelativeSource AncestorType=views:TargetSelectionView}}" Value="True">
              <Setter Property="Margin" Value="0" /><Setter Property="MinHeight" Value="0" />
              <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="controls:SettingsCard"><ContentPresenter Content="{TemplateBinding DescriptionContent}" /></ControlTemplate></Setter.Value></Setter>
            </DataTrigger></Style.Triggers>
          </Style>
        </controls:SettingsCard.Style>
        <controls:SettingsCard.DescriptionContent>
          <WrapPanel>
            <WrapPanel.Style><Style TargetType="WrapPanel"><Setter Property="Margin" Value="0,12,0,0" />
              <Style.Triggers><DataTrigger Binding="{Binding IsOnboarding, RelativeSource={RelativeSource AncestorType=views:TargetSelectionView}}" Value="True"><Setter Property="Orientation" Value="Vertical" /><Setter Property="Margin" Value="0" /></DataTrigger></Style.Triggers>
            </Style></WrapPanel.Style>
            <Border CornerRadius="8" BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    AutomationProperties.Name="{Binding TargetTitle}" AutomationProperties.HelpText="{Binding TargetStatus}">
              <Border.Style><Style TargetType="Border"><Setter Property="Width" Value="144" /><Setter Property="Height" Value="144" /><Setter Property="Margin" Value="0,0,16,8" />
                <Style.Triggers><DataTrigger Binding="{Binding IsOnboarding, RelativeSource={RelativeSource AncestorType=views:TargetSelectionView}}" Value="True"><Setter Property="Width" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=views:TargetSelectionView}}" /><Setter Property="Height" Value="245" /><Setter Property="Margin" Value="0,0,0,15" /></DataTrigger></Style.Triggers>
              </Style></Border.Style>
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <DockPanel Margin="12,10">
                  <DockPanel.Style><Style TargetType="DockPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsOnboarding, RelativeSource={RelativeSource AncestorType=views:TargetSelectionView}}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></DockPanel.Style>
                  <ui:SymbolIcon Symbol="Window24" FontSize="13" Margin="0,0,8,0" /><TextBlock Text="{Binding TargetTitle}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </DockPanel>
                <Image x:Name="TargetPreviewImage" Grid.Row="1" Stretch="Uniform" RenderTransformOrigin="0.5,0.5"
                       AutomationProperties.Name="{Binding TargetTitle}" AutomationProperties.HelpText="{Binding TargetStatus}">
                  <Image.RenderTransform><ScaleTransform /></Image.RenderTransform>
                </Image>
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8">
                  <StackPanel.Style>
                    <Style TargetType="StackPanel">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding HasPreview}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </StackPanel.Style>
                  <ui:SymbolIcon Symbol="Window24" FontSize="32" HorizontalAlignment="Center" />
                  <TextBlock Text="{Binding TargetStatus}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>
              </Grid>
            </Border>
            <StackPanel Margin="0,0,0,8" VerticalAlignment="Center">
              <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Width" Value="280" /><Style.Triggers><DataTrigger Binding="{Binding IsOnboarding, RelativeSource={RelativeSource AncestorType=views:TargetSelectionView}}" Value="True"><Setter Property="Width" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=views:TargetSelectionView}}" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
              <TextBlock Text="{Binding TargetTitle}" ToolTip="{Binding TargetTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding TargetStatus}" Style="{StaticResource Description}" AutomationProperties.LiveSetting="Polite" />
              <TextBlock Text="{Binding PreviewError}" Style="{StaticResource Description}" />
              <WrapPanel Margin="0,8,0,0">
                <WrapPanel.Style><Style TargetType="WrapPanel"><Style.Triggers><DataTrigger Binding="{Binding IsOnboarding, RelativeSource={RelativeSource AncestorType=views:TargetSelectionView}}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></WrapPanel.Style>
                <ui:Button x:Name="SelectWindowButton" Content="{Binding SelectionButtonText}" Command="{Binding SelectWindowCommand}"
                           Style="{StaticResource SettingsActionButton}" Icon="{ui:SymbolIcon Window24}"
                           AutomationProperties.Name="{Binding SelectionButtonText}" />
                <ui:Button Content="{loc:Loc Key=WindowPicker_Retry}" Command="{Binding RetryPreviewCommand}"
                           Style="{StaticResource SettingsButton}" Margin="8,0,0,0"
                           Visibility="{Binding HasPreviewError, Converter={StaticResource BoolToVisibility}}" />
              </WrapPanel>
            </StackPanel>
          </WrapPanel>
        </controls:SettingsCard.DescriptionContent>
      </controls:SettingsCard>
</UserControl>
