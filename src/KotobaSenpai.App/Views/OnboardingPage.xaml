<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:steps="clr-namespace:KotobaSenpai.App.Views.Onboarding"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="KotobaSenpai.App.Views.OnboardingPage"
             Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             xmlns:loc="clr-namespace:KotobaSenpai.App.Localization"
             xmlns:views="clr-namespace:KotobaSenpai.App.Views">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/KotobaSenpai.App;component/Themes/OnboardingStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <DataTemplate x:Key="DictionaryStep">
        <steps:OnboardingDictionaryStep DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=views:OnboardingPage}}" />
      </DataTemplate>
      <DataTemplate x:Key="ModelStep">
        <steps:OnboardingModelStep DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=views:OnboardingPage}}" />
      </DataTemplate>
      <DataTemplate x:Key="WindowStep">
        <steps:OnboardingWindowStep DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=views:OnboardingPage}}" />
      </DataTemplate>
      <DataTemplate x:Key="ReadyStep">
        <steps:OnboardingReadyStep DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=views:OnboardingPage}}" />
      </DataTemplate>
      <steps:OnboardingStepTemplateSelector x:Key="StepTemplates" Dictionary="{StaticResource DictionaryStep}" Model="{StaticResource ModelStep}" Window="{StaticResource WindowStep}" Ready="{StaticResource ReadyStep}" />
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid Margin="30,0,30,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="54" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <DockPanel Margin="3,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <ui:SymbolIcon Symbol="WeatherMoon24" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,6,0" />
        <ComboBox x:Name="OnboardingThemeSelector" Style="{StaticResource OnboardingComboInput}" Width="112" MinHeight="32" FontSize="12" ItemsSource="{Binding Settings.ThemeModes}" DisplayMemberPath="Name" SelectedValuePath="Mode" SelectedValue="{Binding Settings.SelectedTheme, Mode=TwoWay}" AutomationProperties.Name="{loc:Loc Key=Label_Theme}" Margin="0,0,15,0" />
        <ui:SymbolIcon Symbol="LocalLanguage24" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,6,0" />
        <ComboBox x:Name="OnboardingLanguageSelector" Style="{StaticResource OnboardingComboInput}" Width="145" MinHeight="32" FontSize="12" ItemsSource="{Binding Settings.Language.AvailableCultures}" SelectedItem="{Binding Settings.Language.CurrentCulture, Mode=TwoWay}" DisplayMemberPath="NativeName" AutomationProperties.Name="{loc:Loc Key=Label_Language}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Image Source="/KotobaSenpai.App;component/Assets/Branding/app-icon.png" Width="26" Height="26" Margin="0,0,9,0" />
        <TextBlock Text="KotobaSenpai" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>
    </DockPanel>
    <Border x:Name="OnboardingSurface" Grid.Row="1" CornerRadius="16" Background="{DynamicResource LayerFillColorDefaultBrush}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid MaxWidth="650" Margin="42,25,42,0" Visibility="{Binding Onboarding.IsGuideVisible, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{Binding Onboarding.ProgressText}">
          <Border Height="1" Margin="80,14,80,0" VerticalAlignment="Top" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
          <ItemsControl ItemsSource="{Binding Onboarding.Progress}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="4" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <Border x:Name="ProgressBadge" Style="{StaticResource OnboardingStepBadge}" Tag="{Binding IsCurrent}">
                    <TextBlock Text="{Binding Marker}" TextAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Text="{Binding Label}" Margin="0,9,0,0" TextAlignment="Center" Style="{StaticResource OnboardingCaption}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
        <ScrollViewer x:Name="StepScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="42,30,42,28">
          <Grid x:Name="StepBody" VerticalAlignment="Center">
            <Grid.RenderTransform>
              <TranslateTransform />
            </Grid.RenderTransform>
            <ContentControl x:Name="StepContent" Content="{Binding Onboarding.Step}" ContentTemplateSelector="{StaticResource StepTemplates}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" />
          </Grid>
        </ScrollViewer>
        <Grid x:Name="OnboardingFooter" Grid.Row="2" Margin="42,0,42,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="{Binding Onboarding.Error}" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Polite" Visibility="{Binding Onboarding.HasError, Converter={StaticResource BoolToVisibility}}" />
          <Border Grid.Row="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
          <DockPanel Grid.Row="2" Margin="0,19,0,22">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <ui:Button Content="{loc:Loc Key=Install_Retry}" Command="{Binding Onboarding.InitializeCommand}" Style="{StaticResource OnboardingButton}" Margin="0,0,12,0" Visibility="{Binding Onboarding.ShowRetry, Converter={StaticResource BoolToVisibility}}" />
              <ui:Button x:Name="NextButton" Content="{Binding Onboarding.PrimaryActionText}" Command="{Binding Onboarding.NextCommand}" Style="{StaticResource OnboardingPrimaryButton}" Visibility="{Binding Onboarding.IsGuideVisible, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <Grid>
              <ui:Button Content="{loc:Loc Key=Onboarding_Back}" Command="{Binding Onboarding.BackCommand}" HorizontalAlignment="Left" Style="{StaticResource OnboardingLinkButton}" Visibility="{Binding Onboarding.ShowBack, Converter={StaticResource BoolToVisibility}}" />
              <TextBlock Text="{loc:Loc Key=Onboarding_SetupOnce}" VerticalAlignment="Center" Margin="0,0,18,0" TextWrapping="Wrap">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource OnboardingCaption}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Onboarding.ShowBack}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
          </DockPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
