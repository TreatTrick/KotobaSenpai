<Window x:Class="KotobaSenpai.App.Views.Support.SupportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:KotobaSenpai.App.Localization"
        xmlns:support="clr-namespace:KotobaSenpai.App.Views.Support"
        Title="{loc:Loc Key=support.button}" Width="494" SizeToContent="Height"
        WindowStyle="None" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" UseLayoutRounding="True"
        FontFamily="{DynamicResource FluentFontFamily}" FontSize="13"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}" PreviewKeyDown="OnKeyDown">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0"
                  CornerRadius="22" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVisibility" />
    <Style x:Key="SupportButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource SupportButton}" />
    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="5,6" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Segment" CornerRadius="5" Padding="{TemplateBinding Padding}" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
              <ContentPresenter HorizontalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="Segment" Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" /><Setter TargetName="Segment" Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Segment" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border CornerRadius="22" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
          BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
    <Grid Margin="0,18,16,18">
      <Grid.ColumnDefinitions><ColumnDefinition Width="154" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <support:MascotControl x:Name="Mascot" IsPopup="True" Height="280" Margin="0,0,0,10"
                             TargetElement="{Binding ElementName=CloseButton}" VerticalAlignment="Bottom" />
      <StackPanel Grid.Column="1">
        <TextBlock x:Name="HeaderTitle" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,24,5" />
        <TextBlock x:Name="UsageText" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
        <Grid Margin="0,0,0,12">
          <TextBlock x:Name="Subtitle" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          <TextBlock x:Name="AlternateSubtitle" TextWrapping="Wrap" Visibility="Hidden" />
        </Grid>
        <Border Padding="12" CornerRadius="12" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" MinHeight="210">
          <Grid>
            <Grid x:Name="PaymentCard">
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <Border CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="2" AutomationProperties.Name="{loc:Loc Key=support.method}">
                <UniformGrid Columns="3">
                  <RadioButton x:Name="WeChat" GroupName="Payment" Tag="wechat" Content="{loc:Loc Key=payment.wechat}" Checked="OnPaymentChanged" />
                  <RadioButton x:Name="Alipay" GroupName="Payment" Tag="alipay" Content="{loc:Loc Key=payment.alipay}" Checked="OnPaymentChanged" />
                  <RadioButton x:Name="PayPal" GroupName="Payment" Tag="payPal" Content="{loc:Loc Key=support.payment.payPal}" Checked="OnPaymentChanged" />
                </UniformGrid>
              </Border>
              <Grid Grid.Row="1" Margin="0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="112" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Width="112" Height="112" Background="White" CornerRadius="10" Padding="8" VerticalAlignment="Center">
                  <Image x:Name="QrImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                  <TextBlock x:Name="PaymentCaption" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                  <Button x:Name="PayPalLink" Content="{loc:Loc Key=support.paypal.open}" Click="OnPayPal" FontSize="12" Padding="0,6" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" />
                </StackPanel>
              </Grid>
              <Button Grid.Row="2" x:Name="ConfirmButton" Click="OnConfirm" ToolTip="{loc:Loc Key=support.confirm.help}" />
            </Grid>
            <Grid x:Name="ThanksCard" Visibility="Hidden">
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <TextBlock Text="{loc:Loc Key=support.received}" Foreground="#E56796" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Grid.Row="1" Text="{loc:Loc Key=support.thanks.detail}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              <Button Grid.Row="2" Content="{loc:Loc Key=support.payment.show}" Click="OnShowCodes" />
            </Grid>
          </Grid>
        </Border>
        <Button Click="OnGitHub" ToolTip="{loc:Loc Key=support.github.help}" Margin="0,12,0,6" HorizontalContentAlignment="Left"
                AutomationProperties.Name="{loc:Loc Key=support.star}">
          <StackPanel Orientation="Horizontal">
            <Path Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"
                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  Data="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
            <TextBlock Text="{loc:Loc Key=support.star}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <TextBlock Text="{loc:Loc Key=support.github.detail}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <TextBlock x:Name="LinkFeedback" Height="48" Margin="0,7,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
      <Button x:Name="CloseButton" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top"
              Width="24" Height="24" Padding="0" Content="×" FontWeight="Bold"
              ToolTip="{loc:Loc Key=support.close}" AutomationProperties.Name="{loc:Loc Key=support.close}" Click="OnClose">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Circle" CornerRadius="12" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Circle" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Circle" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" /><Setter TargetName="Circle" Property="BorderThickness" Value="1" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Button.Template>
      </Button>
    </Grid>
  </Border>
</Window>
