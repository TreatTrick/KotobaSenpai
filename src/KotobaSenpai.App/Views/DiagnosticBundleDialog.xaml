<Window x:Class="KotobaSenpai.App.Views.DiagnosticBundleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:loc="clr-namespace:KotobaSenpai.App.Localization"
        xmlns:controls="clr-namespace:KotobaSenpai.App.Controls"
        Width="560" SizeToContent="Height" MaxHeight="680"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" UseLayoutRounding="True"
        FontFamily="{DynamicResource FluentFontFamily}" FontSize="{DynamicResource FluentBodyFontSize}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}" KeyDown="OnDialogKeyDown">
  <controls:FluentLightHost>
    <Border x:Name="DialogSurface" Margin="12" CornerRadius="8"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
            controls:FluentLight.Kind="Surface" controls:FluentLight.CornerRadius="8">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBar" Margin="20,16,16,8" MouseLeftButtonDown="OnTitleBarMouseDown">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="DialogTitle" FontSize="16" FontWeight="SemiBold"
                     TextWrapping="Wrap" VerticalAlignment="Center" />
          <ui:Button Grid.Column="1" Width="32" Height="32" Padding="0" Content="×"
                     Style="{StaticResource SettingsIconButton}" Click="OnClose"
                     CornerRadius="4" controls:FluentLight.CornerRadius="4"
                     ToolTip="{loc:Loc Key=DiagnosticExport_Close}"
                     AutomationProperties.Name="{loc:Loc Key=DiagnosticExport_Close}" />
        </Grid>

        <Grid Grid.Row="1" Margin="24,8,24,20">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="28" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <ui:SymbolIcon x:Name="DialogIcon" Symbol="Warning24" FontSize="22" Margin="0,1,0,0"
                         Foreground="{DynamicResource SystemFillColorCriticalBrush}" VerticalAlignment="Top" />
          <StackPanel Grid.Column="1">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
            <ScrollViewer x:Name="DetailsViewer" MaxHeight="280" Margin="0,12,0,12"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <TextBlock x:Name="DetailsText" TextWrapping="Wrap" LineHeight="23" />
            </ScrollViewer>
            <TextBlock x:Name="NoteText" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,0,0,8" />
            <TextBlock x:Name="QuestionText" TextWrapping="Wrap" FontWeight="SemiBold" />
          </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource LayerFillColorDefaultBrush}"
                CornerRadius="0,0,8,8" Padding="20,14">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button x:Name="CancelButton" MinWidth="96" Margin="0,0,8,0"
                       Style="{StaticResource SettingsButton}" Click="OnCancel"
                       CornerRadius="4" controls:FluentLight.CornerRadius="4" />
            <ui:Button x:Name="PrimaryButton" MinWidth="128" Appearance="Primary"
                       Style="{StaticResource SettingsButton}" Click="OnPrimary"
                       CornerRadius="4" controls:FluentLight.CornerRadius="4" IsDefault="True" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </controls:FluentLightHost>
</Window>
