<UserControl x:Class="KotobaSenpai.App.Views.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:KotobaSenpai.App.Localization"
             xmlns:controls="clr-namespace:KotobaSenpai.App.Controls"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <ScrollViewer Style="{StaticResource SettingsPageScrollViewer}">
    <StackPanel>
      <TextBlock Text="{loc:Loc Key=Tab_About}" Style="{StaticResource PageTitle}" />
      <TextBlock Text="{loc:Loc Key=About_Description}" Style="{StaticResource PageDescription}" />
      <Border x:Name="AppInfoCard" Padding="{StaticResource FluentCardPadding}" Margin="0,24,0,0"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
              CornerRadius="8" controls:FluentLight.Kind="Surface" controls:FluentLight.CornerRadius="8">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Image Source="/KotobaSenpai.App;component/Assets/Branding/app-icon.png" Width="56" Height="56"
                 Margin="0,0,20,0" RenderOptions.BitmapScalingMode="HighQuality" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="KotobaSenpai" FontSize="{StaticResource FluentTitleFontSize}" FontWeight="SemiBold" />
            <TextBlock Text="{loc:Loc Key=About_AppDescription}" Style="{StaticResource Description}" />
            <TextBlock Text="{Binding CurrentVersionText}" Style="{StaticResource Description}" />
          </StackPanel>
        </Grid>
      </Border>
      <WrapPanel Margin="0,12,0,0">
        <ui:Button Content="{loc:Loc Key=About_Website}" Tag="https://treattrick.github.io/KotobaSenpai/" Click="OpenLink"
                   Style="{StaticResource SettingsButton}" CornerRadius="4" controls:FluentLight.CornerRadius="4" Margin="0,0,8,8" />
        <ui:Button Content="GitHub" Tag="https://github.com/TreatTrick/KotobaSenpai" Click="OpenLink"
                   Style="{StaticResource SettingsButton}" CornerRadius="4" controls:FluentLight.CornerRadius="4" Margin="0,0,8,8" />
        <ui:Button Content="{loc:Loc Key=About_Feedback}" Tag="https://github.com/TreatTrick/KotobaSenpai/issues" Click="OpenLink"
                   Style="{StaticResource SettingsButton}" CornerRadius="4" controls:FluentLight.CornerRadius="4" Margin="0,0,8,8" />
      </WrapPanel>
      <TextBlock Text="{loc:Loc Key=About_Updates}" Style="{StaticResource SectionTitle}" />
      <controls:SettingsCard Header="{loc:Loc Key=About_Updates}" Icon="{ui:SymbolIcon ArrowSync24}">
        <controls:SettingsCard.DescriptionContent>
          <TextBlock Text="{Binding Status}" Style="{StaticResource Description}" AutomationProperties.LiveSetting="Polite" />
        </controls:SettingsCard.DescriptionContent>
        <ui:Button Content="{loc:Loc Key=About_Check}" Command="{Binding CheckCommand}"
                   Style="{StaticResource SettingsButton}" CornerRadius="4" controls:FluentLight.CornerRadius="4" />
      </controls:SettingsCard>
      <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,12">
        <ProgressBar.Style>
          <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding IsBusy}" Value="True" />
                  <Condition Binding="{Binding IsDownloading}" Value="False" />
                  <Condition Binding="{Binding IsReady}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible" />
              </MultiDataTrigger>
            </Style.Triggers>
          </Style>
        </ProgressBar.Style>
      </ProgressBar>
      <Border x:Name="UpdateDetailsCard" Padding="{StaticResource FluentCardPadding}" Margin="{StaticResource FluentCardGap}"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
              CornerRadius="8" controls:FluentLight.Kind="Surface" controls:FluentLight.CornerRadius="8"
              Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
          <WrapPanel>
            <TextBlock x:Name="LatestVersionLabel" Text="{Binding LatestVersionText}" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="0,0,12,4" />
            <TextBlock Text="{Binding PackageSize}" Style="{StaticResource Description}"
                       VerticalAlignment="Center" Margin="0,0,0,4" />
          </WrapPanel>
          <WrapPanel x:Name="UpdateActions" Margin="0,8,0,0">
            <ui:Button x:Name="DownloadUpdateButton" Content="{loc:Loc Key=About_Download}" Command="{Binding DownloadCommand}" Appearance="Primary"
                       Visibility="{Binding ShowDownload, Converter={StaticResource BoolToVisibility}}"
                       Style="{StaticResource SettingsActionButton}" CornerRadius="4" controls:FluentLight.CornerRadius="4" Margin="0,0,8,8">
              <ui:Button.Icon>
                <ui:ImageIcon Source="{StaticResource UpdateAvailableColorIcon}" Width="20" Height="20" />
              </ui:Button.Icon>
            </ui:Button>
            <ui:Button x:Name="InstallUpdateButton" Content="{loc:Loc Key=About_Install}" Command="{Binding InstallCommand}" Appearance="Primary"
                       Visibility="{Binding IsReady, Converter={StaticResource BoolToVisibility}}"
                       Style="{StaticResource SettingsActionButton}" CornerRadius="4" controls:FluentLight.CornerRadius="4" Margin="0,0,8,8" />
            <ui:Button x:Name="OpenReleaseButton" Content="{loc:Loc Key=About_OpenRelease}" Tag="https://github.com/TreatTrick/KotobaSenpai/releases/latest" Click="OpenLink"
                       Style="{StaticResource SettingsButton}" CornerRadius="4" controls:FluentLight.CornerRadius="4" Margin="0,0,8,8" />
          </WrapPanel>
          <StackPanel Margin="0,12,0,0" Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}">
            <ProgressBar Value="{Binding DownloadProgress}" Height="6" Minimum="0" Maximum="100"
                         AutomationProperties.Name="{loc:Loc Key=About_Download}" />
            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Description}" />
            <ui:Button Content="{loc:Loc Key=About_Cancel}" Command="{Binding CancelDownloadCommand}"
                       HorizontalAlignment="Left" Style="{StaticResource SettingsButton}"
                       CornerRadius="4" controls:FluentLight.CornerRadius="4" Margin="0,8,0,0" />
          </StackPanel>
          <TextBlock x:Name="ReleaseNotesHeading" Text="{loc:Loc Key=About_ReleaseNotes}" Style="{StaticResource SectionTitle}" />
          <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <TextBlock Text="{Binding ReleaseNotes}" TextWrapping="Wrap" />
          </ScrollViewer>
        </StackPanel>
      </Border>
      <TextBlock Text="{loc:Loc Key=About_ManualInstall}" Style="{StaticResource Description}"
                 Visibility="{Binding RequiresManualInstall, Converter={StaticResource BoolToVisibility}}" />
      <TextBlock Text="{loc:Loc Key=About_UpdateHint}" Style="{StaticResource Description}" Margin="0,8,0,0" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
