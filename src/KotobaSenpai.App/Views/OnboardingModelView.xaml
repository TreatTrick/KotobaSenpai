<UserControl x:Class="KotobaSenpai.App.Views.OnboardingModelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:KotobaSenpai.App.Localization"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/KotobaSenpai.App;component/Themes/OnboardingStyles.xaml" />
  </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
  <StackPanel>
    <TabControl x:Name="ConfigurationMethods" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource OnboardingTab}">
      <TabControl.Template><ControlTemplate TargetType="TabControl"><StackPanel>
        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="9" Padding="4" Margin="0,0,0,21"><UniformGrid Rows="1" IsItemsHost="True" /></Border>
        <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
      </StackPanel></ControlTemplate></TabControl.Template>
      <TabItem Header="{loc:Loc Key=Onboarding_Manual}">
        <StackPanel DataContext="{Binding Llm}">
          <TextBlock Text="{loc:Loc Key=Label_LlmProtocol}" Style="{StaticResource OnboardingFieldLabel}" />
          <ComboBox x:Name="ProtocolSelector" ItemsSource="{Binding Protocols}" SelectedValuePath="Id" DisplayMemberPath="Name" SelectedValue="{Binding Protocol, Mode=TwoWay}"
                    Style="{StaticResource OnboardingComboInput}" Margin="0,0,0,14" AutomationProperties.Name="{loc:Loc Key=Label_LlmProtocol}" />
          <TextBlock Text="{loc:Loc Key=Label_LlmEndpoint}" Style="{StaticResource OnboardingFieldLabel}" />
          <TextBox x:Name="EndpointInput" Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OnboardingTextInput}" Margin="0,0,0,14" AutomationProperties.Name="{loc:Loc Key=Label_LlmEndpoint}" />
          <TextBlock Text="{loc:Loc Key=Label_LlmApiKey}" Style="{StaticResource OnboardingFieldLabel}" />
          <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid>
              <PasswordBox x:Name="LlmApiKeyPasswordBox" Style="{StaticResource MaskedApiKeyInput}" MinHeight="38" AutomationProperties.Name="{loc:Loc Key=Label_LlmApiKey}" />
              <TextBox Style="{StaticResource VisibleApiKeyInput}" MinHeight="38" Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:Loc Key=Label_LlmApiKey}" />
            </Grid>
            <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Eye24}" Style="{StaticResource SettingsIconButton}" Command="{Binding ToggleApiKeyVisibilityCommand}" AutomationProperties.Name="{loc:Loc Key=Button_LlmToggleKey}" ToolTip="{loc:Loc Key=Button_LlmToggleKey}" />
          </Grid>
          <TextBlock Text="{loc:Loc Key=Label_LlmModel}" Style="{StaticResource OnboardingFieldLabel}" />
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <ComboBox x:Name="ModelInput" IsEditable="True" ItemsSource="{Binding Models}" DisplayMemberPath="Id" Style="{StaticResource OnboardingComboInput}" Text="{Binding Model, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:Loc Key=Label_LlmModel}" />
            <ui:Button Grid.Column="1" Content="{loc:Loc Key=Button_LlmFetchModels}" Command="{Binding FetchModelsCommand}" VerticalAlignment="Center" Margin="12,0,0,0" Style="{StaticResource OnboardingLinkButton}" />
          </Grid>
          <ProgressBar Height="3" Margin="0,8,0,0" IsIndeterminate="{Binding IsFetchingModels}" Visibility="{Binding IsFetchingModels, Converter={StaticResource BoolToVisibility}}" />
          <TextBlock Text="{Binding ModelStatus}" Style="{StaticResource ModelStatus}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
      </TabItem>
      <TabItem Header="{loc:Loc Key=Onboarding_Assistant}">
        <StackPanel DataContext="{Binding Llm}">
          <ui:SymbolIcon Symbol="Sparkle24" FontSize="32" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Left" Margin="0,0,0,16" />
          <TextBlock Text="{loc:Loc Key=Agent_Title}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10" />
          <TextBlock Text="{loc:Loc Key=Agent_Description}" Style="{StaticResource Description}" Margin="0,0,0,16" />
          <TextBlock Text="{loc:Loc Key=Onboarding_AssistantSteps}" Style="{StaticResource Description}" LineHeight="27" Margin="0,0,0,20" />
          <ui:Button Content="{loc:Loc Key=Agent_CopyPrompt}" Click="CopyAgentPrompt_Click" Style="{StaticResource OnboardingButton}" AutomationProperties.Name="{loc:Loc Key=Agent_CopyPrompt}" />
          <TextBlock Text="{Binding PromptCopyStatus}" Style="{StaticResource ModelStatus}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
      </TabItem>
    </TabControl>
    <StackPanel DataContext="{Binding Llm}" Margin="0,12,0,0">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <ui:Button x:Name="CheckConfigurationButton" Content="{loc:Loc Key=Agent_CheckConfiguration}" Command="{Binding CheckConfigurationCommand}" Style="{StaticResource OnboardingButton}" HorizontalAlignment="Left" AutomationProperties.Name="{loc:Loc Key=Agent_CheckConfiguration}" />
        <Grid x:Name="ConfigurationSuccess" Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"
              Visibility="{Binding IsConfigurationUsable, Converter={StaticResource BoolToVisibility}}">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <ui:SymbolIcon x:Name="ConfigurationSuccessIcon" Symbol="CheckmarkCircle24" FontSize="20" Margin="0,0,7,0"
                         Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
          <TextBlock x:Name="ConfigurationSuccessText" Grid.Column="1" Text="{loc:Loc Key=Onboarding_ConfigurationUsable}" FontSize="13"
                     TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource SystemFillColorSuccessBrush}" AutomationProperties.LiveSetting="Polite" />
        </Grid>
        <ui:Button Grid.Column="2" Content="{loc:Loc Key=Agent_Cancel}" Command="{Binding CancelConfigurationCommand}" Style="{StaticResource OnboardingLinkButton}" Margin="12,0,0,0" Visibility="{Binding IsCheckingConfiguration, Converter={StaticResource BoolToVisibility}}" />
      </Grid>
      <ProgressBar Height="3" Margin="0,12,0,0" IsIndeterminate="{Binding IsCheckingConfiguration}" Visibility="{Binding IsCheckingConfiguration, Converter={StaticResource BoolToVisibility}}" />
      <TextBlock x:Name="ValidationText" Text="{Binding ConfigurationValidationMessage}" TextWrapping="Wrap" Margin="0,12,0,0" FontSize="13"
                 Foreground="{DynamicResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Polite"
                 Visibility="{Binding IsConfigurationUnavailable, Converter={StaticResource BoolToVisibility}}" />
      <TextBlock Text="{Binding ConfigurationStatus}" Style="{StaticResource ModelStatus}" AutomationProperties.LiveSetting="Polite" />
      <TextBlock Text="{Binding ConfigurationErrorDetails}" Style="{StaticResource ModelStatus}" AutomationProperties.LiveSetting="Polite" />
      <ui:Button Content="{loc:Loc Key=Agent_CopyError}" Click="CopyConfigurationError_Click" Style="{StaticResource OnboardingLinkButton}" HorizontalAlignment="Left" Visibility="{Binding IsConfigurationUnavailable, Converter={StaticResource BoolToVisibility}}" />
    </StackPanel>
  </StackPanel>
</UserControl>
