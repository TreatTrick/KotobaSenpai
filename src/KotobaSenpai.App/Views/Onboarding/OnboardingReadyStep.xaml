<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:steps="clr-namespace:KotobaSenpai.App.Views.Onboarding"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:KotobaSenpai.App.Views"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="KotobaSenpai.App.Views.Onboarding.OnboardingReadyStep"
             xmlns:loc="clr-namespace:KotobaSenpai.App.Localization">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/KotobaSenpai.App;component/Themes/OnboardingStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <steps:OnboardingStepLayout>
    <steps:OnboardingStepLayout.Details>
      <StackPanel Margin="0,25,0,0">
        <StackPanel.Resources>
          <Style TargetType="ui:SymbolIcon">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Margin" Value="0,0,11,0" />
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
          </Style>
        </StackPanel.Resources>
        <DockPanel Margin="0,0,0,13">
          <ui:SymbolIcon Symbol="CheckmarkCircle24" />
          <TextBlock Text="{loc:Loc Key=Onboarding_DictionaryReady}" FontSize="13" TextWrapping="Wrap" />
        </DockPanel>
        <DockPanel Margin="0,0,0,13">
          <ui:SymbolIcon Symbol="CheckmarkCircle24" />
          <TextBlock Text="{Binding Settings.Llm.Model}" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding Settings.Llm.Model}" />
        </DockPanel>
        <DockPanel>
          <ui:SymbolIcon Symbol="CheckmarkCircle24" />
          <TextBlock Text="{Binding Selection.TargetTitle}" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding Selection.TargetTitle}" />
        </DockPanel>
      </StackPanel>
    </steps:OnboardingStepLayout.Details>
    <steps:OnboardingStepLayout.Visual>
      <StackPanel>
        <views:TargetSelectionView DataContext="{Binding Selection}" IsOnboarding="True" />
        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="9" Padding="16,13" Margin="0,18,0,0">
          <DockPanel>
            <ui:SymbolIcon Symbol="Sparkle24" FontSize="18" Margin="0,2,11,0" VerticalAlignment="Top" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock Tag="ReadyHint" Text="{loc:Loc Key=Onboarding_ReadyHint}" Style="{StaticResource OnboardingCaption}" />
          </DockPanel>
        </Border>
      </StackPanel>
    </steps:OnboardingStepLayout.Visual>
  </steps:OnboardingStepLayout>
</UserControl>
