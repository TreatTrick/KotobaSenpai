<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:steps="clr-namespace:KotobaSenpai.App.Views.Onboarding"
             x:Class="KotobaSenpai.App.Views.Onboarding.OnboardingPreparationView">
  <steps:OnboardingStepLayout>
    <steps:OnboardingStepLayout.Details>
      <StackPanel Margin="0,24,0,0">
        <TextBlock Text="{Binding Dictionary.StageText}" FontSize="13" AutomationProperties.LiveSetting="Polite"
                   Visibility="{Binding Onboarding.IsPreparingDictionary, Converter={StaticResource BoolToVisibility}}" />
        <ProgressBar Height="4" Margin="0,12,0,0" IsIndeterminate="True"
                     Visibility="{Binding Onboarding.IsBusy, Converter={StaticResource BoolToVisibility}}"
                     AutomationProperties.Name="{Binding Onboarding.HeroTitle}" />
        <TextBlock Text="{Binding Dictionary.Error}" TextWrapping="Wrap" Margin="0,12,0,0"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
    </steps:OnboardingStepLayout.Details>
  </steps:OnboardingStepLayout>
</UserControl>
