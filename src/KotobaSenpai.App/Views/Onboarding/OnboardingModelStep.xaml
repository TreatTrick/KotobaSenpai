<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:steps="clr-namespace:KotobaSenpai.App.Views.Onboarding"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:KotobaSenpai.App.Views"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="KotobaSenpai.App.Views.Onboarding.OnboardingModelStep"
             xmlns:loc="clr-namespace:KotobaSenpai.App.Localization">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/KotobaSenpai.App;component/Themes/OnboardingStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <steps:OnboardingStepLayout>
    <steps:OnboardingStepLayout.Details>
      <StackPanel Margin="0,25,0,0">
        <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,0,0,20" />
        <TextBlock Text="{loc:Loc Key=Label_ExplanationLanguage}" Style="{StaticResource OnboardingFieldLabel}" />
        <DockPanel>
          <ui:Button DockPanel.Dock="Right" Content="{loc:Loc Key=Button_SaveExplanationLanguage}" Command="{Binding Settings.SaveExplanationLanguageCommand}" Style="{StaticResource OnboardingButton}" Margin="9,0,0,0" />
          <TextBox Text="{Binding Settings.ExplanationLanguage, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OnboardingTextInput}" AutomationProperties.Name="{loc:Loc Key=Label_ExplanationLanguage}" ToolTip="{loc:Loc Key=ExplanationLanguage_Help}" />
        </DockPanel>
        <TextBlock Text="{Binding Settings.EffectiveExplanationLanguage}" Style="{StaticResource OnboardingCaption}" Margin="0,8,0,0" />
        <TextBlock Text="{Binding Settings.ExplanationLanguageStatus}" Style="{StaticResource ModelStatus}" AutomationProperties.LiveSetting="Polite" />
        <TextBlock Text="{loc:Loc Key=Onboarding_ExplanationHint}" Style="{StaticResource OnboardingCaption}" Margin="0,8,0,0" />
      </StackPanel>
    </steps:OnboardingStepLayout.Details>
    <steps:OnboardingStepLayout.Visual>
      <views:OnboardingModelView DataContext="{Binding Settings}" />
    </steps:OnboardingStepLayout.Visual>
  </steps:OnboardingStepLayout>
</UserControl>
