<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:steps="clr-namespace:KotobaSenpai.App.Views.Onboarding"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="KotobaSenpai.App.Views.Onboarding.OnboardingDictionaryStep"
             xmlns:loc="clr-namespace:KotobaSenpai.App.Localization"
             xmlns:views="clr-namespace:KotobaSenpai.App.Views">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/KotobaSenpai.App;component/Themes/OnboardingStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <steps:OnboardingStepLayout>
    <steps:OnboardingStepLayout.Details>
      <StackPanel Margin="0,29,0,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Text="{Binding Dictionary.Progress, StringFormat={}{0:P0}}">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource OnboardingCaption}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Dictionary.IsIndeterminate}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <TextBlock Text="{Binding Dictionary.StageText}" FontSize="13" AutomationProperties.LiveSetting="Polite" />
        </DockPanel>
        <ProgressBar Value="{Binding Dictionary.Progress}" Maximum="1" Height="4" Margin="0,12,0,10" IsIndeterminate="{Binding Dictionary.IsIndeterminate}" AutomationProperties.Name="{Binding Dictionary.StageText}" />
        <TextBlock Text="{loc:Loc Key=Onboarding_DictionaryHint}" Style="{StaticResource OnboardingCaption}" FontSize="11" />
        <TextBlock Text="{Binding Dictionary.Error}" Style="{StaticResource ModelStatus}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
    </steps:OnboardingStepLayout.Details>
    <steps:OnboardingStepLayout.Visual>
      <Grid Height="326" MaxWidth="390" Margin="8,12">
        <Border Margin="20,8" CornerRadius="12" Background="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0.09" RenderTransformOrigin="0.5,0.5">
          <Border.RenderTransform>
            <RotateTransform Angle="-6" />
          </Border.RenderTransform>
        </Border>
        <Border Margin="15,8" CornerRadius="12" Background="{DynamicResource ControlFillColorSecondaryBrush}" RenderTransformOrigin="0.5,0.5">
          <Border.RenderTransform>
            <RotateTransform Angle="4" />
          </Border.RenderTransform>
        </Border>
        <Border Margin="10,0" CornerRadius="12" Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="28,24">
          <StackPanel>
            <DockPanel>
              <ui:SymbolIcon DockPanel.Dock="Right" Symbol="BookOpen24" FontSize="17" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
              <TextBlock Text="UniDic" Style="{StaticResource OnboardingCaption}" />
            </DockPanel>
            <TextBlock Text="言葉" Language="ja-JP" FontSize="52" FontWeight="SemiBold" Margin="0,19,0,0" />
            <TextBlock Text="ことば" Language="ja-JP" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,17" />
            <TextBlock Tag="DictionaryDefinition" Text="{loc:Loc Key=Onboarding_DictionaryDefinition}" TextWrapping="Wrap" FontSize="13" LineHeight="21" />
            <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,18,0,13" />
            <TextBlock Language="ja-JP" FontSize="13">
              <Run Text="言葉で、" />
              <Run Text="世界" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
              <Run Text="が広がる。" />
            </TextBlock>
            <TextBlock Tag="DictionarySource" Text="{loc:Loc Key=Onboarding_DictionarySource}" Style="{StaticResource OnboardingCaption}" FontSize="10" Margin="0,10,0,0" />
          </StackPanel>
        </Border>
      </Grid>
    </steps:OnboardingStepLayout.Visual>
  </steps:OnboardingStepLayout>
</UserControl>
