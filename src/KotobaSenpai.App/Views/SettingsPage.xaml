<UserControl x:Class="KotobaSenpai.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:KotobaSenpai.App.Localization"
             xmlns:vm="clr-namespace:KotobaSenpai.App.ViewModels"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:KotobaSenpai.App.Controls">
  <ScrollViewer x:Name="SettingsScrollViewer" Style="{StaticResource SettingsPageScrollViewer}">
    <StackPanel>
      <TextBlock Text="{loc:Loc Key=Tab_Settings}" Style="{StaticResource PageTitle}" />
      <TextBlock Text="{loc:Loc Key=Page_SettingsDescription}" Style="{StaticResource PageDescription}" />
      <TextBlock Text="{loc:Loc Key=Label_Appearance}" Style="{StaticResource SectionTitle}" />

      <controls:SettingsCard Header="{loc:Loc Key=Label_Theme}" Description="{loc:Loc Key=Description_Theme}"
                             Icon="{ui:SymbolIcon PaintBrush24}">
        <ComboBox x:Name="ThemeModeComboBox" Style="{StaticResource SettingInput}"
                  ItemsSource="{Binding ThemeModes}" DisplayMemberPath="Name" SelectedValuePath="Mode"
                  SelectedValue="{Binding SelectedTheme, Mode=TwoWay}"
                  AutomationProperties.Name="{loc:Loc Key=Label_Theme}" />
      </controls:SettingsCard>

      <controls:SettingsCard Header="{loc:Loc Key=Label_Language}" Description="{loc:Loc Key=Description_Language}"
                             Icon="{ui:SymbolIcon LocalLanguage24}">
        <ComboBox x:Name="LanguageComboBox" Style="{StaticResource SettingInput}"
                  ItemsSource="{Binding Language.AvailableCultures}"
                  SelectedItem="{Binding Language.CurrentCulture, Mode=TwoWay}"
                  DisplayMemberPath="NativeName" AutomationProperties.Name="{loc:Loc Key=Label_Language}" />
      </controls:SettingsCard>

      <controls:SettingsCard Header="{loc:Loc Key=Label_FuriganaSize}" Description="{loc:Loc Key=Description_FuriganaSize}"
                             Icon="{ui:SymbolIcon TextFontSize24}">
        <Grid Width="{StaticResource SettingsInputWidth}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="48" />
          </Grid.ColumnDefinitions>
          <Slider x:Name="FuriganaSlider" Minimum="{x:Static vm:SettingsPageViewModel.MinimumFuriganaFontScale}"
                  Maximum="{x:Static vm:SettingsPageViewModel.MaximumFuriganaFontScale}"
                  Value="{Binding FuriganaFontScale, Mode=TwoWay}"
                  VerticalAlignment="Center" MinHeight="{StaticResource FluentControlHeight}" SmallChange="0.01" LargeChange="0.05"
                  AutomationProperties.Name="{loc:Loc Key=Label_FuriganaSize}" />
          <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=FuriganaSlider, StringFormat={}{0:P0}}"
                     HorizontalAlignment="Right" VerticalAlignment="Center"
                     Style="{StaticResource Description}" Margin="0" />
        </Grid>
      </controls:SettingsCard>
      <controls:SettingsCard Header="{loc:Loc Key=Label_ExplanationLanguage}"
                             Description="{loc:Loc Key=Description_ExplanationLanguage}"
                             Icon="{ui:SymbolIcon LocalLanguage24}">
        <StackPanel Width="{StaticResource SettingsInputWidth}">
          <TextBox x:Name="ExplanationLanguageTextBox" Style="{StaticResource SettingTextInput}"
                   Text="{Binding ExplanationLanguage, UpdateSourceTrigger=PropertyChanged}"
                   AutomationProperties.Name="{loc:Loc Key=Label_ExplanationLanguage}" />
          <ui:Button Content="{loc:Loc Key=Button_SaveExplanationLanguage}"
                     Command="{Binding SaveExplanationLanguageCommand}"
                     Style="{StaticResource SettingsButton}" HorizontalAlignment="Right" Margin="0,8,0,0" />
          <TextBlock Text="{Binding EffectiveExplanationLanguage}" Style="{StaticResource ModelStatus}" />
          <TextBlock Text="{Binding ExplanationLanguageStatus}" Style="{StaticResource ModelStatus}"
                     AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
      </controls:SettingsCard>
      <StackPanel DataContext="{Binding Llm}">
        <TextBlock Text="{loc:Loc Key=Label_LlmSettings}" Style="{StaticResource SectionTitle}" />

        <controls:SettingsCard Header="{loc:Loc Key=Label_LlmEnabled}" Description="{loc:Loc Key=Description_LlmEnabled}"
                               Icon="{ui:SymbolIcon Sparkle24}">
          <ui:ToggleSwitch IsChecked="{Binding Enabled, Mode=TwoWay}" Style="{StaticResource SettingsToggle}"
                           OnContent="{loc:Loc Key=Toggle_On}" OffContent="{loc:Loc Key=Toggle_Off}"
                           AutomationProperties.Name="{loc:Loc Key=Label_LlmEnabled}" />
        </controls:SettingsCard>

        <controls:SettingsCard Header="{loc:Loc Key=Label_LlmProtocol}" Description="{loc:Loc Key=Description_LlmProtocol}"
                               Icon="{ui:SymbolIcon PlugConnected24}">
          <ComboBox Style="{StaticResource SettingInput}" ItemsSource="{Binding Protocols}"
                    ToolTip="{Binding SelectedItem.Name, RelativeSource={RelativeSource Self}}"
                    SelectedValuePath="Id" DisplayMemberPath="Name"
                    SelectedValue="{Binding Protocol, Mode=TwoWay}" AutomationProperties.Name="{loc:Loc Key=Label_LlmProtocol}" />
        </controls:SettingsCard>

        <controls:SettingsCard Header="{loc:Loc Key=Label_LlmEndpoint}" Description="{loc:Loc Key=Description_LlmEndpoint}"
                               Icon="{ui:SymbolIcon Globe24}">
          <TextBox Width="{StaticResource SettingsInputWidth}" Style="{StaticResource SettingTextInput}"
                   Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}"
                   AutomationProperties.Name="{loc:Loc Key=Label_LlmEndpoint}" />
        </controls:SettingsCard>

        <controls:SettingsCard Header="{loc:Loc Key=Label_LlmApiKey}" Description="{loc:Loc Key=Description_LlmApiKey}"
                               Icon="{ui:SymbolIcon Key24}">
          <Grid Width="{StaticResource SettingsInputWidth}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid>
              <PasswordBox x:Name="LlmApiKeyPasswordBox" Style="{StaticResource MaskedApiKeyInput}"
                           PasswordChanged="LlmApiKeyPasswordBox_PasswordChanged" AutomationProperties.Name="{loc:Loc Key=Label_LlmApiKey}" />
              <TextBox x:Name="LlmApiKeyTextBox" Style="{StaticResource VisibleApiKeyInput}"
                       Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="{loc:Loc Key=Label_LlmApiKey}" />
            </Grid>
            <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Eye24}" Style="{StaticResource SettingsIconButton}"
                       Command="{Binding ToggleApiKeyVisibilityCommand}"
                       ToolTip="{loc:Loc Key=Button_LlmToggleKey}" AutomationProperties.Name="{loc:Loc Key=Button_LlmToggleKey}" />
          </Grid>
        </controls:SettingsCard>

        <controls:SettingsCard Header="{loc:Loc Key=Label_LlmModel}" Description="{loc:Loc Key=Description_LlmModel}"
                               Icon="{ui:SymbolIcon Cube24}">
          <StackPanel Width="{StaticResource SettingsInputWidth}">
            <ComboBox IsEditable="True" IsTextSearchEnabled="True" Style="{StaticResource SettingInput}"
                      ItemsSource="{Binding Models}" DisplayMemberPath="Id"
                      Text="{Binding Model, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      AutomationProperties.Name="{loc:Loc Key=Label_LlmModel}" />
            <ui:Button Content="{loc:Loc Key=Button_LlmFetchModels}" Icon="{ui:SymbolIcon ArrowClockwise24}"
                       Command="{Binding FetchModelsCommand}" Style="{StaticResource SettingsButton}" HorizontalAlignment="Right" Margin="0,8,0,0" />
            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,8,0,0"
                         Visibility="{Binding IsFetchingModels, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding ModelStatus}" Style="{StaticResource ModelStatus}" AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
        </controls:SettingsCard>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
