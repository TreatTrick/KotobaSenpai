<UserControl x:Class="KotobaSenpai.App.Views.RecognitionPage"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:KotobaSenpai.App.Localization"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:KotobaSenpai.App.Views"
             xmlns:controls="clr-namespace:KotobaSenpai.App.Controls">
  <UserControl.Resources>
    <Style x:Key="TargetRequiredActionButton" TargetType="ui:Button" BasedOn="{StaticResource SettingsActionButton}">
      <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
      <Setter Property="ToolTipService.IsEnabled" Value="False" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Selection.SelectedWindow}" Value="{x:Null}">
          <Setter Property="ToolTipService.IsEnabled" Value="True" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>
  <ScrollViewer Style="{StaticResource SettingsPageScrollViewer}">
    <StackPanel>
      <TextBlock Text="{loc:Loc Key=Tab_Recognize}" Style="{StaticResource PageTitle}" />
      <TextBlock Text="{loc:Loc Key=Page_RecognizeDescription}" Style="{StaticResource PageDescription}" />
      <TextBlock Text="{loc:Loc Key=Label_TargetAndRecognition}" Style="{StaticResource SectionTitle}" />

      <views:TargetSelectionView x:Name="WindowSelection" DataContext="{Binding Selection}" />

      <controls:SettingsCard Header="{loc:Loc Key=Label_RecognizeText}" Description="{loc:Loc Key=Description_RecognizeText}"
                             Icon="{ui:SymbolIcon ScanText24}">
        <WrapPanel MaxWidth="300">
        <ui:Button x:Name="RecognizeButton" Content="{loc:Loc Key=Button_Recognize}" Command="{Binding RecognizeCommand}"
                   Style="{StaticResource TargetRequiredActionButton}" IsDefault="{Binding IsVisible, RelativeSource={RelativeSource Self}}"
                   ToolTip="{loc:Loc Key=Status_SelectTargetFirst}"
                   AutomationProperties.AcceleratorKey="{Binding Shortcuts.Recognize.Hint}"
                   Icon="{ui:SymbolIcon Play24}" Appearance="Primary" />
        <ContentControl Content="{Binding Shortcuts.Recognize}" Style="{StaticResource ShortcutHint}" />
        </WrapPanel>
      </controls:SettingsCard>

      <ui:Card x:Name="AnnotationLegendCard" Padding="{StaticResource FluentCardPadding}" Margin="{StaticResource FluentCardGap}"
               controls:FluentLight.Kind="Surface" controls:FluentLight.CornerRadius="8"
               Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
               BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" HorizontalContentAlignment="Stretch">
        <StackPanel>
          <WrapPanel>
            <TextBlock Text="{loc:Loc Key=AnnotationLegend_Title}" FontWeight="SemiBold" Margin="0,0,24,8" />
            <StackPanel Orientation="Horizontal" Margin="0,0,20,8">
              <Ellipse x:Name="PitchHighSwatch" Width="10" Height="10" Margin="0,0,8,0"
                       Fill="{Binding Appearance.PitchHighColor, ElementName=Root}"
                       Stroke="{DynamicResource TextFillColorSecondaryBrush}" StrokeThickness="0.5" />
              <TextBlock Text="{loc:Loc Key=OverlayPitchHighColor}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,20,8">
              <Ellipse x:Name="PitchLowSwatch" Width="10" Height="10" Margin="0,0,8,0"
                       Fill="{Binding Appearance.PitchLowColor, ElementName=Root}"
                       Stroke="{DynamicResource TextFillColorSecondaryBrush}" StrokeThickness="0.5" />
              <TextBlock Text="{loc:Loc Key=OverlayPitchLowColor}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Border x:Name="PitchHeibanSwatch" Width="12" Height="5" Margin="0,0,8,0" CornerRadius="2"
                      Background="{Binding Appearance.PitchHeibanColor, ElementName=Root}"
                      BorderBrush="{DynamicResource TextFillColorSecondaryBrush}" BorderThickness="0.5" />
              <TextBlock Text="{loc:Loc Key=AnnotationLegend_Heiban}" />
            </StackPanel>
          </WrapPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.2*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Center">
              <controls:OverlayAppearancePreview x:Name="AnnotationLegendPreview" ShowPitchNumbers="True"
                                                 Appearance="{Binding Appearance, ElementName=Root}"
                                                 AutomationProperties.Name="{loc:Loc Key=AnnotationLegend_Sample}" />
            </Viewbox>
            <StackPanel Grid.Column="1" Margin="12,0,0,8" VerticalAlignment="Center">
              <TextBlock Text="{loc:Loc Key=AnnotationLegend_Reading}" Style="{StaticResource Description}" Margin="0,0,0,8" />
              <TextBlock Text="{loc:Loc Key=AnnotationLegend_PitchNumbers}" Style="{StaticResource Description}" Margin="0" />
            </StackPanel>
          </Grid>
          <TextBlock Text="{loc:Loc Key=AnnotationLegend_ColorMeaning}" Style="{StaticResource Description}" />
        </StackPanel>
      </ui:Card>

      <controls:SettingsCard Header="{loc:Loc Key=Label_RecognitionRegion}" Description="{loc:Loc Key=Description_RecognitionRegion}"
                             Icon="{ui:SymbolIcon Crop24}">
        <WrapPanel MaxWidth="300">
          <ui:Button x:Name="RegionButton" Content="{loc:Loc Key=Button_SetRecognitionRegion}" Command="{Binding SetRecognitionRegionCommand}"
                     Style="{StaticResource TargetRequiredActionButton}" ToolTip="{loc:Loc Key=Status_SelectTargetFirst}"
                     AutomationProperties.AcceleratorKey="{Binding Shortcuts.Region.Hint}" />
          <ContentControl Content="{Binding Shortcuts.Region}" Style="{StaticResource ShortcutHint}" />
        </WrapPanel>
      </controls:SettingsCard>
      <TextBlock Text="{loc:Loc Key=Label_RecognitionBehavior}" Style="{StaticResource SectionTitle}" />

      <controls:SettingsCard Header="{loc:Loc Key=Label_AutoRecognition}" Description="{loc:Loc Key=Description_AutoRecognition}"
                             Icon="{ui:SymbolIcon ArrowSync24}">
        <WrapPanel MaxWidth="300">
        <ui:ToggleSwitch x:Name="AutoRecognitionToggle" IsChecked="{Binding AutoRecognitionEnabled, Mode=TwoWay}" Style="{StaticResource SettingsToggle}"
                         OnContent="{loc:Loc Key=Toggle_On}" OffContent="{loc:Loc Key=Toggle_Off}"
                         AutomationProperties.AcceleratorKey="{Binding Shortcuts.Automatic.Hint}"
                         AutomationProperties.Name="{loc:Loc Key=Label_AutoRecognition}" />
        <ContentControl Content="{Binding Shortcuts.Automatic}" Style="{StaticResource ShortcutHint}" />
        </WrapPanel>
      </controls:SettingsCard>
      <TextBlock Text="{Binding RunState}" Style="{StaticResource Description}" AutomationProperties.LiveSetting="Polite" />

      <controls:SettingsCard Header="{loc:Loc Key=Reading_VisibilityTitle}" Description="{loc:Loc Key=Reading_VisibilityDescription}"
                             Icon="{ui:SymbolIcon EyeOff24}">
        <WrapPanel MaxWidth="300">
          <ui:Button Content="{Binding VisibilityButtonText}" Command="{Binding ToggleVisibilityCommand}"
                     Style="{StaticResource SettingsActionButton}"
                     AutomationProperties.AcceleratorKey="{Binding Shortcuts.Visibility.Hint}" />
          <ContentControl Content="{Binding Shortcuts.Visibility}" Style="{StaticResource ShortcutHint}" />
        </WrapPanel>
      </controls:SettingsCard>

      <controls:SettingsCard Header="{loc:Loc Key=Label_Overlay}" Description="{loc:Loc Key=Description_Overlay}"
                             Icon="{ui:SymbolIcon EyeOff24}">
        <WrapPanel MaxWidth="300">
          <ui:Button Content="{loc:Loc Key=Button_Hide}" Command="{Binding HideCommand}" Style="{StaticResource SettingsActionButton}"
                     AutomationProperties.AcceleratorKey="{Binding Shortcuts.Stop.Hint}" />
          <ContentControl Content="{Binding Shortcuts.Stop}" Style="{StaticResource ShortcutHint}" />
        </WrapPanel>
      </controls:SettingsCard>
      <TextBlock Text="{Binding Status}" Style="{StaticResource Description}" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
