<ui:FluentWindow x:Class="KotobaSenpai.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:KotobaSenpai.App.Localization"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{loc:Loc Key=MainWindow_Title}"
        Width="700" Height="560"
        MinWidth="560" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">
  <ui:FluentWindow.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </ui:FluentWindow.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="{loc:Loc Key=MainWindow_Title}" />

    <TabControl Grid.Row="1" BorderThickness="0" Padding="0" Background="Transparent">

      <!-- Tab 1: Recognize -->
      <TabItem Header="{loc:Loc Key=Tab_Recognize}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,8">
          <StackPanel>

            <TextBlock Text="{loc:Loc Key=Label_TargetWindow}"
                       FontWeight="SemiBold" Margin="0,0,0,8" />
            <ui:Card Padding="12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" ItemsSource="{Binding Windows}"
                          SelectedItem="{Binding SelectedWindow}" DisplayMemberPath="Title" />
                <ui:Button Grid.Column="1" Content="{loc:Loc Key=Button_RefreshWindows}"
                           Command="{Binding RefreshCommand}"
                           Appearance="Secondary" Margin="10,0,0,0" />
              </Grid>
            </ui:Card>

            <TextBlock Text="{loc:Loc Key=Label_Actions}"
                       FontWeight="SemiBold" Margin="0,20,0,8" />
            <ui:Card Padding="16">
              <StackPanel>
                <ui:Button Content="{loc:Loc Key=Button_Recognize}" Command="{Binding RecognizeCommand}"
                           IsDefault="True" Appearance="Primary" HorizontalAlignment="Stretch" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <ui:Button Content="{loc:Loc Key=Button_SetRecognitionRegion}"
                             Command="{Binding SetRecognitionRegionCommand}" Appearance="Secondary" />
                  <ui:Button Content="{loc:Loc Key=Button_Hide}"
                             Command="{Binding HideCommand}" Appearance="Secondary" Margin="8,0,0,0" />
                </StackPanel>
                <CheckBox Content="{loc:Loc Key=Label_AutoRecognition}"
                          IsChecked="{Binding AutoRecognitionEnabled, Mode=TwoWay}" Margin="0,14,0,0" />
                <TextBlock Text="{loc:Loc Key=Label_Description}" TextWrapping="Wrap"
                           Margin="0,14,0,0" Opacity="0.7" />
              </StackPanel>
            </ui:Card>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Tab: Settings -->
      <TabItem Header="{loc:Loc Key=Tab_Settings}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,8">
          <StackPanel>
            <TextBlock Text="{loc:Loc Key=Label_LlmSettings}" FontWeight="SemiBold" Margin="0,0,0,8" />
            <ui:Card Padding="14">
              <StackPanel>
                <CheckBox Content="{loc:Loc Key=Label_LlmEnabled}"
                          IsChecked="{Binding LlmSettings.Enabled, Mode=TwoWay}" />
                <TextBlock Text="{loc:Loc Key=Label_LlmProtocol}" Margin="0,12,0,4" />
                <ComboBox ItemsSource="{Binding LlmSettings.Protocols}"
                          SelectedValuePath="Id" DisplayMemberPath="Name"
                          SelectedValue="{Binding LlmSettings.Protocol, Mode=TwoWay}" />
                <TextBlock Text="{loc:Loc Key=Label_LlmEndpoint}" Margin="0,12,0,4" />
                <TextBox Text="{Binding LlmSettings.Endpoint, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{loc:Loc Key=Label_LlmApiKey}" Margin="0,12,0,4" />
                <Grid>
                  <PasswordBox x:Name="LlmApiKeyPasswordBox"
                             PasswordChanged="LlmApiKeyPasswordBox_PasswordChanged">
                    <PasswordBox.Style>
                      <Style TargetType="PasswordBox">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding LlmSettings.IsApiKeyVisible}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </PasswordBox.Style>
                  </PasswordBox>
                  <TextBox Text="{Binding LlmSettings.ApiKey, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.Style>
                      <Style TargetType="TextBox">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding LlmSettings.IsApiKeyVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBox.Style>
                  </TextBox>
                </Grid>
                <ui:Button Content="{loc:Loc Key=Button_LlmToggleKey}"
                           Command="{Binding LlmSettings.ToggleApiKeyVisibilityCommand}"
                           Appearance="Secondary" HorizontalAlignment="Right" Margin="0,4,0,0" />
                <TextBlock Text="{loc:Loc Key=Label_LlmModel}" Margin="0,12,0,4" />
                <ComboBox IsEditable="True" IsTextSearchEnabled="True"
                          ItemsSource="{Binding LlmSettings.Models}" DisplayMemberPath="Id"
                          Text="{Binding LlmSettings.Model, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <ui:Button Content="{loc:Loc Key=Button_LlmFetchModels}"
                             Command="{Binding LlmSettings.FetchModelsCommand}" Appearance="Primary" />
                  <ProgressBar IsIndeterminate="True" Width="80" Height="4"
                               VerticalAlignment="Center" Margin="12,0,0,0"
                               Visibility="{Binding LlmSettings.IsFetchingModels, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <TextBlock Text="{Binding LlmSettings.ModelStatus}" TextWrapping="Wrap"
                           Margin="0,8,0,0" Opacity="0.75" />
              </StackPanel>
            </ui:Card>
            <TextBlock Text="{loc:Loc Key=Label_Appearance}" FontWeight="SemiBold" Margin="0,20,0,8" />
            <ui:Card Padding="14">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{loc:Loc Key=Label_Theme}" VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1" x:Name="ThemeModeComboBox" Width="200"
                            SelectionChanged="ThemeModeComboBox_SelectionChanged">
                    <ComboBoxItem Content="{loc:Loc Key=ThemeMode_Auto}" Tag="Auto" />
                    <ComboBoxItem Content="{loc:Loc Key=ThemeMode_Light}" Tag="Light" />
                    <ComboBoxItem Content="{loc:Loc Key=ThemeMode_Dark}" Tag="Dark" />
                  </ComboBox>
                </Grid>
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{loc:Loc Key=Label_Language}" VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1" Width="200"
                            ItemsSource="{Binding LanguageService.AvailableCultures, RelativeSource={RelativeSource AncestorType=Window}}"
                            SelectedItem="{Binding LanguageService.CurrentCulture, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                            DisplayMemberPath="NativeName" />
                </Grid>
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{loc:Loc Key=Label_FuriganaSize}" VerticalAlignment="Center" />
                  <Slider Grid.Column="1" x:Name="FuriganaSlider" Width="200"
                          Minimum="0.1" Maximum="0.5" ValueChanged="FuriganaSlider_ValueChanged" />
                </Grid>
              </StackPanel>
            </ui:Card>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

    </TabControl>

    <!-- Status bar -->
    <Border Grid.Row="2" Padding="24,8,24,14">
      <TextBlock Text="{Binding Status}" Opacity="0.7" TextWrapping="Wrap" />
    </Border>

    <!-- Dictionary install blocking overlay (shown during install/failure; blocks all other controls) -->
    <Grid Grid.Row="0" Grid.RowSpan="3" Background="#99000000"
          Visibility="{Binding InstallController.IsBlocking, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
      <ui:Card Width="380" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock Text="{loc:Loc Key=Install_Title}" FontWeight="SemiBold" FontSize="16"
                     TextAlignment="Center" Margin="0,0,0,16" />
          <ProgressBar Value="{Binding InstallController.Progress, RelativeSource={RelativeSource AncestorType=Window}}"
                       Maximum="1" Height="6" />
          <TextBlock Text="{loc:Loc Key=Install_Progress}" Opacity="0.7"
                     TextAlignment="Center" Margin="0,10,0,0" />
          <TextBlock Text="{Binding InstallController.Error, RelativeSource={RelativeSource AncestorType=Window}}"
                     Foreground="#E81123" TextWrapping="Wrap" TextAlignment="Center" Margin="0,14,0,0"
                     Visibility="{Binding InstallController.HasError, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
          <ui:Button Content="{loc:Loc Key=Install_Retry}"
                     Command="{Binding InstallController.InstallCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                     Appearance="Primary" HorizontalAlignment="Center" Margin="0,16,0,0"
                     Visibility="{Binding InstallController.HasError, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
      </ui:Card>
    </Grid>
  </Grid>
</ui:FluentWindow>
