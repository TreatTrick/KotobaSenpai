<ui:FluentWindow x:Class="KotobaSenpai.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:KotobaSenpai.App.Localization"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:KotobaSenpai.App.Views"
        x:Name="RootWindow"
        Title="{loc:Loc Key=MainWindow_Title}"
        Icon="Assets/Branding/app-icon.ico"
        Width="1100" Height="800" MinWidth="900" MinHeight="620"
        FontFamily="{StaticResource FluentFontFamily}" FontSize="{StaticResource FluentBodyFontSize}"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" UseLayoutRounding="True">


  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <ui:TitleBar Title="{loc:Loc Key=MainWindow_Title}" Height="48">
      <ui:TitleBar.Icon>
        <ui:ImageIcon Source="Assets/Branding/app-icon.ico" Width="20" Height="20" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <ContentControl Grid.Row="1" Content="{Binding}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
      <ContentControl.Resources>
        <DataTemplate x:Key="GuideContent"><views:OnboardingPage /></DataTemplate>
        <DataTemplate x:Key="MainContent"><views:MainContentView /></DataTemplate>
      </ContentControl.Resources>
      <ContentControl.Style>
        <Style TargetType="ContentControl">
          <Setter Property="ContentTemplate" Value="{StaticResource GuideContent}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding Onboarding.IsMain}" Value="True">
              <Setter Property="ContentTemplate" Value="{StaticResource MainContent}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </ContentControl.Style>
    </ContentControl>
  </Grid>
</ui:FluentWindow>
