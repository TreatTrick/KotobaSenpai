<ui:FluentWindow x:Class="KotobaSenpai.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:KotobaSenpai.App.Localization"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{loc:Loc Key=MainWindow_Title}"
        Width="720" Height="540"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">
  <ui:FluentWindow.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </ui:FluentWindow.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="{loc:Loc Key=MainWindow_Title}" />

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,8,20,8">
      <StackPanel>

        <!-- 目标窗口 -->
        <TextBlock Text="{loc:Loc Key=Label_TargetWindow}" FontWeight="SemiBold" Margin="0,4,0,6" />
        <ui:Card Padding="14">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0"
                      ItemsSource="{Binding Windows}"
                      SelectedItem="{Binding SelectedWindow}" DisplayMemberPath="Title" />
            <ui:Button Grid.Column="1" Content="{loc:Loc Key=Button_RefreshWindows}"
                       Command="{Binding RefreshCommand}" Appearance="Secondary" Margin="12,0,0,0" />
          </Grid>
        </ui:Card>

        <!-- 操作 -->
        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
          <ui:Button Content="{loc:Loc Key=Button_Recognize}" Command="{Binding RecognizeCommand}" IsDefault="True" Appearance="Primary" />
          <ui:Button Content="{loc:Loc Key=Button_SetRecognitionRegion}" Command="{Binding SetRecognitionRegionCommand}" Appearance="Secondary" Margin="8,0,0,0" />
          <ui:Button Content="{loc:Loc Key=Button_Hide}" Command="{Binding HideCommand}" Appearance="Secondary" Margin="8,0,0,0" />
        </StackPanel>
        <TextBlock Text="{loc:Loc Key=Label_Description}" TextWrapping="Wrap" Margin="0,12,0,0" Opacity="0.7" />

        <!-- 外观 -->
        <TextBlock Text="{loc:Loc Key=Label_Appearance}" FontWeight="SemiBold" Margin="0,20,0,6" />
        <ui:Card Padding="14">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{loc:Loc Key=Label_Theme}" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" x:Name="ThemeModeComboBox" Width="200" SelectionChanged="ThemeModeComboBox_SelectionChanged">
                <ComboBoxItem Content="{loc:Loc Key=ThemeMode_Auto}" Tag="Auto" />
                <ComboBoxItem Content="{loc:Loc Key=ThemeMode_Light}" Tag="Light" />
                <ComboBoxItem Content="{loc:Loc Key=ThemeMode_Dark}" Tag="Dark" />
              </ComboBox>
            </Grid>
            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{loc:Loc Key=Label_Language}" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" Width="200"
                        ItemsSource="{Binding LanguageService.AvailableCultures, RelativeSource={RelativeSource AncestorType=Window}}"
                        SelectedItem="{Binding LanguageService.CurrentCulture, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                        DisplayMemberPath="NativeName" />
            </Grid>
            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{loc:Loc Key=Label_FuriganaSize}" VerticalAlignment="Center" />
              <Slider Grid.Column="1" x:Name="FuriganaSlider" Width="200" Minimum="0.1" Maximum="0.5"
                      ValueChanged="FuriganaSlider_ValueChanged" />
            </Grid>
          </StackPanel>
        </ui:Card>

      </StackPanel>
    </ScrollViewer>

    <TextBlock Grid.Row="2" Text="{Binding Status}" Margin="20,4,20,12" Opacity="0.7" />

    <!-- 词典安装遮挡层：安装中/失败时阻断其余所有操作（标题栏保留，可关窗）。 -->
    <Grid Grid.Row="1" Grid.RowSpan="2" Background="#99000000"
          Visibility="{Binding InstallController.IsBlocking, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
      <ui:Card Width="380" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock Text="{loc:Loc Key=Install_Title}" FontWeight="SemiBold" FontSize="16"
                     TextAlignment="Center" Margin="0,0,0,16" />
          <ProgressBar Value="{Binding InstallController.Progress, RelativeSource={RelativeSource AncestorType=Window}}" Maximum="1" Height="6" />
          <TextBlock Text="{loc:Loc Key=Install_Progress}" Opacity="0.7" TextAlignment="Center" Margin="0,10,0,0" />
          <TextBlock Text="{Binding InstallController.Error, RelativeSource={RelativeSource AncestorType=Window}}"
                     Foreground="#E81123" TextWrapping="Wrap" TextAlignment="Center" Margin="0,14,0,0"
                     Visibility="{Binding InstallController.HasError, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
          <ui:Button Content="{loc:Loc Key=Install_Retry}" Command="{Binding InstallController.InstallCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                     Appearance="Primary" HorizontalAlignment="Center" Margin="0,16,0,0"
                     Visibility="{Binding InstallController.HasError, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
      </ui:Card>
    </Grid>
  </Grid>
</ui:FluentWindow>
