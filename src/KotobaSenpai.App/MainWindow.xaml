<Window x:Class="KotobaSenpai.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:KotobaSenpai.App.Localization"
        Title="{loc:Loc Key=MainWindow_Title}"
        Width="720" Height="460"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0">
      <Button Content="{loc:Loc Key=Button_RefreshWindows}" Command="{Binding RefreshCommand}" DockPanel.Dock="Right" />
      <ComboBox DockPanel.Dock="Right" Width="150" Margin="8,0,0,0" VerticalAlignment="Center"
                ItemsSource="{Binding LanguageService.AvailableCultures, RelativeSource={RelativeSource AncestorType=Window}}"
                SelectedItem="{Binding LanguageService.CurrentCulture, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                DisplayMemberPath="NativeName" />
      <TextBlock Text="{loc:Loc Key=Label_Language}" VerticalAlignment="Center" Margin="0,0,6,0" DockPanel.Dock="Right" />
      <TextBlock Text="{loc:Loc Key=Label_TargetWindow}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
    </DockPanel>

    <ComboBox Grid.Row="1" Margin="0,12,0,12" ItemsSource="{Binding Windows}"
              SelectedItem="{Binding SelectedWindow}" DisplayMemberPath="Title" />

    <Border Grid.Row="2" BorderBrush="#DDD" BorderThickness="1" Padding="12">
      <StackPanel>
        <TextBlock Text="{loc:Loc Key=Label_Actions}" FontWeight="SemiBold" />
        <WrapPanel Margin="0,8,0,0">
          <Button Content="{loc:Loc Key=Button_Recognize}" Command="{Binding RecognizeCommand}" IsDefault="True" />
          <Button Content="{loc:Loc Key=Button_Hide}" Command="{Binding HideCommand}" />
        </WrapPanel>
        <TextBlock Text="{loc:Loc Key=Label_Description}"
                   TextWrapping="Wrap" Margin="4,12,4,0" Foreground="#555" />
      </StackPanel>
    </Border>

    <TextBlock Grid.Row="3" Text="{Binding Status}" Margin="0,14,0,0" Foreground="#333" />
  </Grid>
</Window>
