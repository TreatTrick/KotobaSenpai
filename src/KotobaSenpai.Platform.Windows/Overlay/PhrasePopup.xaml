<Window x:Class="KotobaSenpai.Platform.Windows.Overlay.PhrasePopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="#F21B1B1B"
        ShowInTaskbar="False" Topmost="False" ShowActivated="False" ResizeMode="NoResize">
    <Window.Resources>
        <SolidColorBrush x:Key="HeadingBrush" Color="White" />
        <SolidColorBrush x:Key="LabelBrush" Color="#8AD8FF" />
        <SolidColorBrush x:Key="BodyBrush" Color="#E6E6E6" />
        <SolidColorBrush x:Key="PitchBrush" Color="#88FF88" />
        <SolidColorBrush x:Key="PosBrush" Color="#9AC0FF" />
        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BodyBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="OptionalText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HeadingText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="Foreground" Value="{StaticResource HeadingBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource LabelBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style x:Key="Section" TargetType="ContentControl">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding Mode=OneTime}" Style="{StaticResource BodyText}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <StackPanel>
                            <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                       Style="{StaticResource SectionLabel}" />
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Content" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="Content" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="MemberWord">
            <StackPanel Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Headword, Mode=OneTime}" FontWeight="SemiBold" Foreground="{StaticResource HeadingBrush}" />
                    <TextBlock Text="{Binding Reading, Mode=OneTime}" Foreground="{StaticResource LabelBrush}" />
                    <TextBlock Text="{Binding Pitch, Mode=OneTime}" Foreground="{StaticResource PitchBrush}" />
                    <TextBlock Text="{Binding Pos, Mode=OneTime}" Foreground="{StaticResource PosBrush}" />
                </StackPanel>
                <TextBlock Text="{Binding Meaning, Mode=OneTime}" Style="{StaticResource OptionalText}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="ContentPanel">
            <TextBlock x:Name="Heading" Text="{Binding Heading, Mode=OneTime}" Style="{StaticResource HeadingText}" />
            <ContentControl x:Name="PosSection" Content="{Binding Pos, Mode=OneTime}" Tag="{Binding PosLabel, Mode=OneTime}" Style="{StaticResource Section}" />
            <ContentControl x:Name="PitchSection" Content="{Binding Pitch, Mode=OneTime}" Tag="{Binding PitchLabel, Mode=OneTime}" Style="{StaticResource Section}" />
            <ContentControl x:Name="MeaningSection" Content="{Binding Meaning, Mode=OneTime}" Tag="{Binding MeaningLabel, Mode=OneTime}" Style="{StaticResource Section}" />
            <ContentControl x:Name="GrammarSection" Content="{Binding Grammar, Mode=OneTime}" Tag="{Binding GrammarLabel, Mode=OneTime}" Style="{StaticResource Section}" />
            <ContentControl x:Name="WordsSection" Content="{Binding Words, Mode=OneTime}" Tag="{Binding WordsLabel, Mode=OneTime}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl" BasedOn="{StaticResource Section}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Words.Count, Mode=OneTime}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
                <ContentControl.ContentTemplate>
                    <DataTemplate>
                        <ItemsControl ItemsSource="{Binding Mode=OneTime}" ItemTemplate="{StaticResource MemberWord}" />
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
            <TextBlock x:Name="NoMeaningHint" Text="{Binding NoMeaningHint, Mode=OneTime}"
                       Style="{StaticResource OptionalText}" Opacity="0.8" />
        </StackPanel>
    </ScrollViewer>
</Window>
