<Window x:Class="KotobaSenpai.Platform.Windows.Overlay.PhrasePopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False" Topmost="False" ShowActivated="False" ResizeMode="NoResize">
  <Window.Resources>
    <!-- Color tokens -->
    <Color x:Key="SurfaceColor">#EE1A1A2E</Color>
    <Color x:Key="BorderColor">#33FFFFFF</Color>
    <Color x:Key="AccentColor">#5B9CF6</Color>

    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="HeadingBrush" Color="#F0F4FF" />
    <SolidColorBrush x:Key="LabelBrush" Color="#8AB4F8" />
    <SolidColorBrush x:Key="BodyBrush" Color="#D8DEF0" />
    <SolidColorBrush x:Key="PitchBrush" Color="#6EE7A0" />
    <SolidColorBrush x:Key="PosBrush" Color="#93C5FD" />
    <SolidColorBrush x:Key="DividerBrush" Color="#22FFFFFF" />

    <Style x:Key="BodyText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource BodyBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="LineHeight" Value="20" />
    </Style>

    <Style x:Key="OptionalText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
      <Style.Triggers>
        <Trigger Property="Text" Value="">
          <Setter Property="Visibility" Value="Collapsed" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="HeadingText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource HeadingBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="SectionLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource LabelBrush}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,3" />
    </Style>

    <Style x:Key="Section" TargetType="ContentControl">
      <Setter Property="Margin" Value="0,0,0,10" />
      <Setter Property="ContentTemplate">
        <Setter.Value>
          <DataTemplate>
            <TextBlock Text="{Binding Mode=OneTime}" Style="{StaticResource BodyText}" />
          </DataTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContentControl">
            <StackPanel>
              <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                         Style="{StaticResource SectionLabel}" />
              <ContentPresenter Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
            </StackPanel>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Content" Value="{x:Null}">
          <Setter Property="Visibility" Value="Collapsed" />
        </Trigger>
        <Trigger Property="Content" Value="">
          <Setter Property="Visibility" Value="Collapsed" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <DataTemplate x:Key="MemberWord">
      <StackPanel Margin="0,0,0,8">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
          <TextBlock Text="{Binding Headword, Mode=OneTime}" FontWeight="SemiBold"
                     FontSize="13" Foreground="{StaticResource HeadingBrush}" />
          <TextBlock Text="{Binding Reading, Mode=OneTime}"
                     Foreground="{StaticResource LabelBrush}" Margin="6,0,0,0" />
          <TextBlock Text="{Binding Pitch, Mode=OneTime}"
                     Foreground="{StaticResource PitchBrush}" Margin="6,0,0,0" />
          <TextBlock Text="{Binding Pos, Mode=OneTime}"
                     Foreground="{StaticResource PosBrush}" Margin="6,0,0,0" />
        </StackPanel>
        <TextBlock Text="{Binding Meaning, Mode=OneTime}" Style="{StaticResource OptionalText}" />
      </StackPanel>
    </DataTemplate>
  </Window.Resources>

  <!-- Outer drop-shadow frame -->
  <Border CornerRadius="10" Background="Transparent"
          Effect="{x:Null}">
    <Border CornerRadius="10" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Accent bar -->
        <Border Grid.Row="0" Height="3" CornerRadius="10,10,0,0"
                Background="{StaticResource AccentBrush}" />

        <!-- Content -->
        <ScrollViewer Grid.Row="1" MaxHeight="340"
                      VerticalScrollBarVisibility="Auto" Padding="16,14,16,16">
          <StackPanel x:Name="ContentPanel">
            <TextBlock x:Name="Heading" Text="{Binding Heading, Mode=OneTime}"
                       Style="{StaticResource HeadingText}" />
            <ContentControl x:Name="PosSection"
                            Content="{Binding Pos, Mode=OneTime}"
                            Tag="{Binding PosLabel, Mode=OneTime}"
                            Style="{StaticResource Section}" />
            <ContentControl x:Name="PitchSection"
                            Content="{Binding Pitch, Mode=OneTime}"
                            Tag="{Binding PitchLabel, Mode=OneTime}"
                            Style="{StaticResource Section}" />
            <ContentControl x:Name="MeaningSection"
                            Content="{Binding Meaning, Mode=OneTime}"
                            Tag="{Binding MeaningLabel, Mode=OneTime}"
                            Style="{StaticResource Section}" />
            <ContentControl x:Name="GrammarSection"
                            Content="{Binding Grammar, Mode=OneTime}"
                            Tag="{Binding GrammarLabel, Mode=OneTime}"
                            Style="{StaticResource Section}" />
            <ContentControl x:Name="WordsSection"
                            Content="{Binding Words, Mode=OneTime}"
                            Tag="{Binding WordsLabel, Mode=OneTime}">
              <ContentControl.Style>
                <Style TargetType="ContentControl" BasedOn="{StaticResource Section}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Words.Count, Mode=OneTime}" Value="0">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ContentControl.Style>
              <ContentControl.ContentTemplate>
                <DataTemplate>
                  <ItemsControl ItemsSource="{Binding Mode=OneTime}"
                                ItemTemplate="{StaticResource MemberWord}" />
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>
            <TextBlock x:Name="NoMeaningHint"
                       Text="{Binding NoMeaningHint, Mode=OneTime}"
                       Style="{StaticResource OptionalText}" Opacity="0.6" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>
  </Border>
</Window>
