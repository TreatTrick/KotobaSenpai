<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\KotobaSenpai.Core\KotobaSenpai.Core.csproj" />
    <FrameworkReference Include="Microsoft.Windows.SDK.NET.Ref" />
  </ItemGroup>
  <ItemGroup>
    <!-- 日语分词：冻结的 MeCab 移植库 0.10.2，加载 UniDic unidic22 词典（GPL/LGPL 双许可，见 THIRD-PARTY-NOTICES）。 -->
    <PackageReference Include="LibNMeCab" Version="0.10.2" />
    <!-- meikiocr 本地 ONNX OCR：CPU 推理（实测 DirectML 拉低检测置信度致全灭，故不用 GPU 提供程序）。 -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
    <!-- 双线性缩放（对齐 OpenCV INTER_LINEAR），用于检测/识别前处理。 -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <!-- 本地日英词典：JMdict 索引按需查询（数据待磁盘，不常驻内存）。 -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <!-- 显式钉到已修复 e_sqlite3 漏洞（GHSA-2m69-gcr7-jv3q）的版本，覆盖传递依赖的 2.1.11。 -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
  </ItemGroup>
  <ItemGroup>
    <!-- 模型仅随发布打包，不入 git；开发/测试用 KOTOBA_MEIKIOCR_MODEL_DIR 覆盖。 -->
    <None Include="Models\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
